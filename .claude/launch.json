{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "stage-copilot",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "app.py",
        "--server.port",
        "8511",
        "--server.headless",
        "true"
      ],
      "port": 8511,
      "env": {
        "APP_PASSWORD": ""
      }
    },
    {
      "name": "feed-demo",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "tools/feed_demo.py",
        "--server.port",
        "8512",
        "--server.headless",
        "true"
      ],
      "port": 8512
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "api.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "web-next",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    }
  ]
}