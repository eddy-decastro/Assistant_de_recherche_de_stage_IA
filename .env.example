# ============================================================
# stage_copilot — Variables d'environnement (modèle)
# Copiez ce fichier en `.env` puis renseignez votre clé.
# Le fichier `.env` ne doit JAMAIS être committé (voir .gitignore).
# ============================================================

# Clé API Google Gemini (Juge LLM & Lettres de motivation)
GEMINI_API_KEY=votre_cle_gemini_ici

# Clé API DeepSeek (optionnelle si Gemini utilisé)
DEEPSEEK_API_KEY=sk-votre-cle-ici

# ------------------------------------------------------------
# Sécurité & Déploiement Cloud (Render)
# ------------------------------------------------------------
# Mot de passe pour déverrouiller l'accès web à Streamlit :
APP_PASSWORD=mon_mot_de_passe_secret

# ------------------------------------------------------------
# Synchronisation Cloud (Cloudflare R2 / AWS S3)
# ------------------------------------------------------------
# Permet de synchroniser la base SQLite sur le cloud gratuitement
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=stage-copilot
# Alternative générique S3 (ex: AWS, Supabase Storage, Scaleway) :
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=

# ------------------------------------------------------------
# JobTeaser (intranet école) — page /fr/job-offers
# ------------------------------------------------------------
# Chaîne cookie complète capturée dans le navigateur (recommandé) :
# DevTools > Network > requête "job-offers" > Request Headers > Cookie
JOBTEASER_COOKIES=
# Repli si vous préférez extraire les cookies individuellement :
JOBTEASER_SESSION=
JOBTEASER_CF_CLEARANCE=
# Sous-domaine de votre école et chemin de la page d'offres :
JOBTEASER_BASE_URL=https://emse.jobteaser.com
JOBTEASER_OFFERS_PATH=/fr/job-offers
# Profil TLS impersoné par curl_cffi (contourne le challenge Cloudflare) :
JOBTEASER_IMPERSONATE=chrome
# Localisation (défaut : France). Options Paris : JOBTEASER_LAT / _LNG / _RADIUS
JOBTEASER_LOCATION=France
JOBTEASER_LAT=
JOBTEASER_LNG=
JOBTEASER_RADIUS=
JOBTEASER_CONTRACT_DURATION=
JOBTEASER_WORK_EXPERIENCE_CODE=

